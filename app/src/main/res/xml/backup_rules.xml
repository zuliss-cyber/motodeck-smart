<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled. Keep this rule explicit so settings and the optional weather
     API key can never leave the device through a legacy full-backup path. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
